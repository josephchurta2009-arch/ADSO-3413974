<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_Process_BackOffice" targetNamespace="http://schedulesena.local/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <bpmn:process id="Process_BackOffice" name="Gestión documental y auditoría de Back-office" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="ls" name="Sistema">
        <bpmn:flowNodeRef>f</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lb" name="Back-office">
        <bpmn:flowNodeRef>b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Acceso concedido" />
    <bpmn:userTask id="a" name="Consultar lista de documentos" />
    <bpmn:userTask id="b" name="Seleccionar o crear plantilla" />
    <bpmn:exclusiveGateway id="c" name="¿Generar documento?" />
    <bpmn:userTask id="d" name="Generar documento desde plantilla" />
    <bpmn:serviceTask id="f" name="Almacenar documento y versión">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="store-document-version" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="g" name="Consultar auditoría" />
    <bpmn:userTask id="h" name="Gestionar catálogos y parámetros" />
    <bpmn:serviceTask id="i" name="Registrar cambio en auditoría">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="audit-backoffice-change" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e" name="Fin" />
    <bpmn:sequenceFlow id="f1" sourceRef="s" targetRef="a" />
    <bpmn:sequenceFlow id="f2" sourceRef="a" targetRef="b" />
    <bpmn:sequenceFlow id="f3" sourceRef="b" targetRef="c" />
    <bpmn:sequenceFlow id="f4" name="Sí" sourceRef="c" targetRef="d" />
    <bpmn:sequenceFlow id="f5" sourceRef="d" targetRef="f" />
    <bpmn:sequenceFlow id="f6" sourceRef="f" targetRef="g" />
    <bpmn:sequenceFlow id="f7" name="No" sourceRef="c" targetRef="g" />
    <bpmn:sequenceFlow id="f8" sourceRef="g" targetRef="h" />
    <bpmn:sequenceFlow id="f9" sourceRef="h" targetRef="i" />
    <bpmn:sequenceFlow id="f10" sourceRef="i" targetRef="e" />
  </bpmn:process>
