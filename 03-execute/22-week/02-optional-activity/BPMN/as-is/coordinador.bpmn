<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_Process_Coordinador" targetNamespace="http://schedulesena.local/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <bpmn:process id="Process_Coordinador" name="Gestión de horarios del coordinador" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="ls" name="Sistema">
        <bpmn:flowNodeRef>a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>l</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lc" name="Coordinador">
        <bpmn:flowNodeRef>b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>k</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Acceso concedido" />
    <bpmn:serviceTask id="a" name="Cargar dashboard">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="load-coordinator-dashboard" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="b" name="Revisar estado general" />
    <bpmn:userTask id="c" name="Crear o abrir horario" />
    <bpmn:userTask id="d" name="Agregar o editar sesión" />
    <bpmn:serviceTask id="f" name="Verificar conflictos">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-schedule-conflicts" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g" name="¿Hay conflictos?" />
    <bpmn:userTask id="h" name="Resolver conflicto" />
    <bpmn:userTask id="i" name="Revisar disponibilidad de ambientes" />
    <bpmn:userTask id="k" name="Confirmar publicación" />
    <bpmn:serviceTask id="l" name="Publicar horario">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-schedule" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="m" name="Consultar fichas relacionadas" />
    <bpmn:endEvent id="e" name="Horario publicado" />
    <bpmn:sequenceFlow id="f1" sourceRef="s" targetRef="a" />
    <bpmn:sequenceFlow id="f2" sourceRef="a" targetRef="b" />
    <bpmn:sequenceFlow id="f3" sourceRef="b" targetRef="c" />
    <bpmn:sequenceFlow id="f4" sourceRef="c" targetRef="d" />
    <bpmn:sequenceFlow id="f5" sourceRef="d" targetRef="f" />
    <bpmn:sequenceFlow id="f6" sourceRef="f" targetRef="g" />
    <bpmn:sequenceFlow id="f7" name="Sí" sourceRef="g" targetRef="h" />
    <bpmn:sequenceFlow id="f8" sourceRef="h" targetRef="d" />
    <bpmn:sequenceFlow id="f9" name="No" sourceRef="g" targetRef="i" />
    <bpmn:sequenceFlow id="f10" sourceRef="i" targetRef="k" />
    <bpmn:sequenceFlow id="f11" sourceRef="k" targetRef="l" />
    <bpmn:sequenceFlow id="f12" sourceRef="l" targetRef="m" />
    <bpmn:sequenceFlow id="f13" sourceRef="m" targetRef="e" />
  </bpmn:process>
