  <bpmn:process id="Process_Aprendiz" name="Consulta de horario del aprendiz" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="ls" name="Sistema">
        <bpmn:flowNodeRef>a</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="la" name="Aprendiz">
        <bpmn:flowNodeRef>b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Acceso concedido" />
    <bpmn:serviceTask id="a" name="Cargar horario semanal">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="load-learner-schedule" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="b" name="Revisar formaciones programadas" />
    <bpmn:userTask id="c" name="Consultar detalle de clase" />
    <bpmn:userTask id="d" name="Revisar notificaciones" />
    <bpmn:userTask id="f" name="Consultar detalle de notificación" />
    <bpmn:endEvent id="e" name="Fin" />
    <bpmn:sequenceFlow id="f1" sourceRef="s" targetRef="a" />
    <bpmn:sequenceFlow id="f2" sourceRef="a" targetRef="b" />
    <bpmn:sequenceFlow id="f3" sourceRef="b" targetRef="c" />
    <bpmn:sequenceFlow id="f4" sourceRef="c" targetRef="d" />
    <bpmn:sequenceFlow id="f5" sourceRef="d" targetRef="f" />
    <bpmn:sequenceFlow id="f6" sourceRef="f" targetRef="e" />
  </bpmn:process>
