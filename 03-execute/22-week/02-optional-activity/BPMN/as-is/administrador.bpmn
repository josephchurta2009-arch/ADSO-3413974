<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_Process_Administrador" targetNamespace="http://schedulesena.local/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <bpmn:process id="Process_Administrador" name="Administración de usuarios, roles y parámetros" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="ls" name="Sistema">
        <bpmn:flowNodeRef>k</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lad" name="Administrador">
        <bpmn:flowNodeRef>b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Acceso concedido" />
    <bpmn:serviceTask id="a" name="Cargar panel de indicadores">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="load-kpi-panel" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="b" name="Consultar indicadores generales" />
    <bpmn:userTask id="c" name="Revisar drill-down de KPI" />
    <bpmn:userTask id="d" name="Administrar usuarios" />
    <bpmn:userTask id="f" name="Crear, editar o consultar usuario" />
    <bpmn:exclusiveGateway id="g" name="¿Cambia rol del usuario?" />
    <bpmn:userTask id="h" name="Asignar o revocar rol" />
    <bpmn:serviceTask id="i" name="Aplicar cambio de permisos">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="apply-role-change" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>Flow_1hmxd8a</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="j" name="Gestionar datos de referencia y parámetros" />
    <bpmn:serviceTask id="k" name="Registrar cambio en auditoría">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="audit-admin-change" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1hmxd8a</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e" name="Fin" />
    <bpmn:sequenceFlow id="f1" sourceRef="s" targetRef="a" />
    <bpmn:sequenceFlow id="f2" sourceRef="a" targetRef="b" />
    <bpmn:sequenceFlow id="f3" sourceRef="b" targetRef="c" />
    <bpmn:sequenceFlow id="f4" sourceRef="c" targetRef="d" />
    <bpmn:sequenceFlow id="f5" sourceRef="d" targetRef="f" />
    <bpmn:sequenceFlow id="f6" sourceRef="f" targetRef="g" />
    <bpmn:sequenceFlow id="f7" name="Sí" sourceRef="g" targetRef="h" />
    <bpmn:sequenceFlow id="f8" sourceRef="h" targetRef="i" />
    <bpmn:sequenceFlow id="f10" name="No" sourceRef="g" targetRef="j" />
    <bpmn:sequenceFlow id="f11" sourceRef="j" targetRef="i" />
    <bpmn:sequenceFlow id="f12" sourceRef="k" targetRef="e" />
    <bpmn:sequenceFlow id="Flow_1hmxd8a" sourceRef="i" targetRef="k" />
  </bpmn:process>
