<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_Process_AuthShell" targetNamespace="http://schedulesena.local/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <bpmn:process id="Process_AuthShell" name="Autenticación y Shell" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="ls" name="Sistema">
        <bpmn:flowNodeRef>b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>h</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lu" name="Usuario">
        <bpmn:flowNodeRef>a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>f</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Inicio" />
    <bpmn:userTask id="a" name="Ingresar credenciales" />
    <bpmn:serviceTask id="b" name="Validar credenciales">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-credentials" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g" name="¿Credenciales válidas?" />
    <bpmn:userTask id="c" name="Solicitar recuperación de contraseña" />
    <bpmn:serviceTask id="d" name="Enviar enlace de recuperación">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-password-reset-link" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="f" name="Establecer nueva contraseña" />
    <bpmn:serviceTask id="h" name="Actualizar credencial">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="update-credential" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="i" name="Cargar App Shell según rol">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="load-app-shell" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:userTask id="j" name="Consultar notificaciones y estados globales" />
    <bpmn:endEvent id="e" name="Sesión iniciada" />
    <bpmn:sequenceFlow id="f1" sourceRef="s" targetRef="a" />
    <bpmn:sequenceFlow id="f2" sourceRef="a" targetRef="b" />
    <bpmn:sequenceFlow id="f3" sourceRef="b" targetRef="g" />
    <bpmn:sequenceFlow id="f4" name="No" sourceRef="g" targetRef="c" />
    <bpmn:sequenceFlow id="f5" sourceRef="c" targetRef="d" />
    <bpmn:sequenceFlow id="f6" sourceRef="d" targetRef="f" />
    <bpmn:sequenceFlow id="f7" sourceRef="f" targetRef="h" />
    <bpmn:sequenceFlow id="f8" sourceRef="h" targetRef="a" />
    <bpmn:sequenceFlow id="f9" name="Sí" sourceRef="g" targetRef="i" />
    <bpmn:sequenceFlow id="f10" sourceRef="i" targetRef="j" />
    <bpmn:sequenceFlow id="f11" sourceRef="j" targetRef="e" />
  </bpmn:process>
